{
  "name": "01-arrangement-support",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "スティールダーツ01のアレンジ（チェックアウト／セットアップ）判断規則を学ぶためのオフラインPWA",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/copy-spa-fallback.mjs",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc -b --force",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:gate-open": "node scripts/e2e-gate-open.mjs",
    "build:pages": "node scripts/build-pages.mjs",
    "icons": "python3 scripts/generate-icons.py",
    "import:checkout": "node scripts/import-checkout-excel.mjs",
    "check:base": "node scripts/check-base-path.mjs",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run build",
    "audit:training": "vite-node scripts/audit-training.ts",
    "audit:simulation": "vite-node scripts/audit-simulation.ts",
    "audit:review": "vite-node scripts/audit-review.ts"
  },
  "dependencies": {
    "@mlc-ai/web-llm": "0.2.85",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.56.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.15.3",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.4.0",
    "jsdom": "^27.0.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0",
    "vite": "^7.1.9",
    "vite-node": "^6.0.0",
    "vite-plugin-pwa": "^1.0.3",
    "vitest": "^3.2.4"
  }
}
